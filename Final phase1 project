SELECT name, physical_name, type_desc,
       size * 8 / 1024 AS Size_MB,
       CASE max_size WHEN -1 THEN 'UNLIMITED' ELSE CAST(max_size * 8 / 1024 AS VARCHAR(20)) + ' MB' END AS Max_Size,
       CASE is_percent_growth WHEN 1 THEN CAST(growth AS VARCHAR(10)) + ' %'
            ELSE CAST(growth * 8 / 1024 AS VARCHAR(10)) + ' MB' END AS Growth
FROM sys.database_files;

SELECT OBJECT_NAME(parent_object_id) AS TableName, name AS ConstraintName, type_desc
FROM sys.objects
WHERE type IN ('PK','F','UQ','C','D')
ORDER BY TableName, type_desc;
GO
