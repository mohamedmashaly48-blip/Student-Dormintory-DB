CREATE TABLE dbo.Buildings
(
    Building_Id      INT IDENTITY(1,1) NOT NULL,
    Building_Name    VARCHAR(50)       NOT NULL,
    Address          VARCHAR(100)      NOT NULL,
    Number_of_Floors INT               NOT NULL
        CONSTRAINT DF_Buildings_Floors DEFAULT 1,

    CONSTRAINT PK_Buildings        PRIMARY KEY (Building_Id),
    CONSTRAINT UQ_Buildings_Name   UNIQUE (Building_Name),
    CONSTRAINT CK_Buildings_Floors CHECK (Number_of_Floors > 0)
) ON [PRIMARY];
GO

CREATE TABLE dbo.Rooms
(
    Room_Id      INT IDENTITY(1,1) NOT NULL,
    Room_Number  INT               NOT NULL,
    Capacity     INT               NOT NULL,
    Monthly_Rent DECIMAL(10,2)     NOT NULL,
    Room_Type    VARCHAR(20)       NOT NULL
        CONSTRAINT DF_Rooms_Type DEFAULT 'Double',
    Building_Id  INT               NOT NULL,

    CONSTRAINT PK_Rooms                 PRIMARY KEY (Room_Id),
    CONSTRAINT FK_Rooms_Buildings       FOREIGN KEY (Building_Id)
                                        REFERENCES dbo.Buildings (Building_Id),
    CONSTRAINT UQ_Rooms_Building_Number UNIQUE (Building_Id, Room_Number),
    CONSTRAINT CK_Rooms_Capacity        CHECK (Capacity BETWEEN 1 AND 6),
    CONSTRAINT CK_Rooms_Rent            CHECK (Monthly_Rent > 0),
    CONSTRAINT CK_Rooms_Type            CHECK (Room_Type IN ('Single','Double','Triple'))
) ON [PRIMARY];
GO

CREATE TABLE dbo.Student
(
    Student_Id      INT IDENTITY(1,1) NOT NULL,
    First_Name      VARCHAR(50)       NOT NULL,
    Last_Name       VARCHAR(50)       NOT NULL,
    Email           VARCHAR(100)      NOT NULL,
    Phone           VARCHAR(20)       NOT NULL,
    Date_of_Birth   DATE              NOT NULL,
    Enrollment_Date DATE              NOT NULL
        CONSTRAINT DF_Student_Enrollment DEFAULT GETDATE(),

    CONSTRAINT PK_Student        PRIMARY KEY (Student_Id),
    CONSTRAINT UQ_Student_Email  UNIQUE (Email),
    CONSTRAINT UQ_Student_Phone  UNIQUE (Phone),
    CONSTRAINT CK_Student_Email  CHECK (Email LIKE '%_@_%._%'),
    CONSTRAINT CK_Student_Dates  CHECK (Enrollment_Date > Date_of_Birth)
) ON [PRIMARY];
GO

CREATE TABLE dbo.Staff
(
    Staff_Id   INT IDENTITY(1,1) NOT NULL,
    First_Name VARCHAR(50)       NOT NULL,
    Last_Name  VARCHAR(50)       NOT NULL,
    Role       VARCHAR(50)       NOT NULL,
    Phone      VARCHAR(20)       NOT NULL,

    CONSTRAINT PK_Staff       PRIMARY KEY (Staff_Id),
    CONSTRAINT UQ_Staff_Phone UNIQUE (Phone)
) ON [PRIMARY];
GO

CREATE TABLE dbo.Room_Assignments
(
    Assignment_Id INT IDENTITY(1,1) NOT NULL,
    Start_Date    DATE              NOT NULL
        CONSTRAINT DF_Assignments_Start DEFAULT GETDATE(),
    End_Date      DATE              NOT NULL,
    Status        VARCHAR(20)       NOT NULL
        CONSTRAINT DF_Assignments_Status DEFAULT 'Active',
    Student_Id    INT               NOT NULL,
    Room_Id       INT               NOT NULL,

    CONSTRAINT PK_Room_Assignments          PRIMARY KEY (Assignment_Id),
    CONSTRAINT FK_Room_Assignments_Student  FOREIGN KEY (Student_Id)
                                            REFERENCES dbo.Student (Student_Id),
    CONSTRAINT FK_Room_Assignments_Rooms    FOREIGN KEY (Room_Id)
                                            REFERENCES dbo.Rooms (Room_Id),
    CONSTRAINT CK_Room_Assignments_Dates    CHECK (End_Date >= Start_Date),
    CONSTRAINT CK_Room_Assignments_Status   CHECK (Status IN ('Active','Completed','Cancelled'))
) ON [PRIMARY];
GO

CREATE TABLE dbo.Payments
(
    Payment_Id    INT IDENTITY(1,1) NOT NULL,
    Amount        DECIMAL(10,2)     NOT NULL,
    Payment_Date  DATE              NOT NULL
        CONSTRAINT DF_Payments_Date DEFAULT GETDATE(),
    Payment_Month DATE              NOT NULL,
    Status        VARCHAR(20)       NOT NULL
        CONSTRAINT DF_Payments_Status DEFAULT 'Pending',
    Student_Id    INT               NOT NULL,
    Assignment_Id INT               NOT NULL,

    CONSTRAINT PK_Payments                 PRIMARY KEY (Payment_Id),
    CONSTRAINT FK_Payments_Student         FOREIGN KEY (Student_Id)
                                           REFERENCES dbo.Student (Student_Id),
    CONSTRAINT FK_Payments_Room_Assignments FOREIGN KEY (Assignment_Id)
                                           REFERENCES dbo.Room_Assignments (Assignment_Id),
    CONSTRAINT CK_Payments_Amount          CHECK (Amount > 0),
    CONSTRAINT CK_Payments_Status          CHECK (Status IN ('Paid','Pending','Overdue'))
) ON [FG_Operations];
GO

CREATE TABLE dbo.Maintenance_Requests
(
    Request_Id   INT IDENTITY(1,1) NOT NULL,
    Description  VARCHAR(500)      NOT NULL,
    Request_Date DATE              NOT NULL
        CONSTRAINT DF_Maintenance_Date DEFAULT GETDATE(),
    Status       VARCHAR(20)       NOT NULL
        CONSTRAINT DF_Maintenance_Status DEFAULT 'Pending',
    Student_Id   INT               NOT NULL,
    Room_Id      INT               NOT NULL,
    Staff_Id     INT               NOT NULL,

    CONSTRAINT PK_Maintenance_Requests         PRIMARY KEY (Request_Id),
    CONSTRAINT FK_Maintenance_Requests_Student FOREIGN KEY (Student_Id)
                                               REFERENCES dbo.Student (Student_Id),
    CONSTRAINT FK_Maintenance_Requests_Rooms   FOREIGN KEY (Room_Id)
                                               REFERENCES dbo.Rooms (Room_Id),
    CONSTRAINT FK_Maintenance_Requests_Staff   FOREIGN KEY (Staff_Id)
                                               REFERENCES dbo.Staff (Staff_Id),
    CONSTRAINT CK_Maintenance_Status           CHECK (Status IN ('Pending','In Progress','Completed'))
) ON [FG_Operations];
GO

